[Unit]
Description=RemoteIO API (Express + pigpio)
After=network-online.target
Wants=network-online.target
[Service]
User=root
WorkingDirectory=/opt/remoteio/api
ExecStart=/usr/bin/node /opt/remoteio/api/server.js
Restart=on-failure
Environment=NODE_ENV=production
[Install]
WantedBy=multi-user.target
